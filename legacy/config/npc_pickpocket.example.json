{
  "monitor": 1,
  "dry_run": true,
  "debug": true,
  "debug_dir": "logs/debug",
  "max_runtime_hours": 1,
  "loop_delay_seconds": 1.0,
  "region": "utm_runelite_game_view",
  "target_selection": "largest",
  "click_offset": {
    "x": 0,
    "y": 0
  },
  "cyan_detection": {
    "hue_min": 80,
    "hue_max": 100,
    "saturation_min": 80,
    "value_min": 100,
    "min_area": 80,
    "morph_open": 2,
    "dilate": 3
  },
  "mouse": {
    "move_duration_min": 0.18,
    "move_duration_max": 0.38,
    "click_pause_seconds": 0.12,
    "random_offset_pixels": 4,
    "point_tolerance_pixels": 5
  },
  "safety": {
    "stop_hotkey": "cmd+shift+q",
    "enable_esc_stop": true,
    "failsafe_corner_pixels": 5
  }
}
